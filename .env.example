# Copie este arquivo para .env.local e preencha.
# A chave abaixo é só para uso local. No site publicado, não configure chave:
# cada visitante usa a própria, colada em Configurações.
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de texto. Troque aqui se o Google renomear ou aposentar o modelo.
GEMINI_TEXT_MODEL=gemini-flash-lite-latest

# Modelo reserva, usado se o principal estiver sobrecarregado.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash

# Modelo do Módulo 1 da v2 (escolher as palavras de um tema): mais forte, porque a chamada é pequena
GEMINI_THEME_MODEL=gemini-3.5-flash

# Voz (TTS). Modelo principal, reservas e voz.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK=gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Banco do cache da v2 (Neon Postgres, conectado pela Vercel → Storage). Opcional:
# sem ele, o app funciona igual, só que sem reaproveitar palavras já geradas.
DATABASE_URL=

# Login (Neon Auth). Opcional: sem estas duas, o login fica desligado e tudo funciona sem conta.
# NEON_AUTH_BASE_URL: Neon Console → Auth → copie a "Auth URL"
# NEON_AUTH_COOKIE_SECRET: um texto aleatório de 32+ caracteres (ex.: openssl rand -base64 32)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Painel de produto (/painel). E-mails que podem abrir, separados por vírgula.
# Sem esta variável, ninguém acessa o painel (404).
ADMIN_EMAILS=

# Envio dos eventos do painel. Fica ligado só em produção; no `next dev` os
# eventos não saem do navegador. Para testar o envio localmente: 1.
NEXT_PUBLIC_EVENTOS=
